SUPABASE_URL=https://lrgllzvwgvqagcpiyvfd.supabase.co
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_ORIGINS=https://vvhl-hub.vercel.app
# Explicitly approved management account UUIDs, verified against Supabase Auth.
VIDEO_REVIEW_USER_IDS=
OPENAI_API_KEY=
# Choose an image-input Responses API model available in your API account.
OPENAI_MODEL=
DATA_DIR=/data
PORT=8080
MAX_UPLOAD_MB=700
MAX_STORAGE_MB=1800
MEDIA_RETENTION_HOURS=24

# Live period watcher. Crops only the scoreboard and uses local Tesseract OCR.
LIVE_PERIOD_WATCH_SECONDS=20
LIVE_PERIOD_CONFIRM_READS=2
LIVE_SCOREBOARD_CROP_LEFT=0.30
LIVE_SCOREBOARD_CROP_TOP=0.00
LIVE_SCOREBOARD_CROP_WIDTH=0.40
LIVE_SCOREBOARD_CROP_HEIGHT=0.16
# Optional worker-only model routing (OpenRouter). Does not affect the site chat,
# which reads CLAUDE_MODEL on Vercel. Unset = use the Hitmen GM profile model.
# VOD_ANALYZER_MODEL=anthropic/claude-sonnet-5.5   # one model for all analyzer steps
# VOD_MODEL_BASIC=qwen/qwen3.8-27b:free,dots-studio/dots-3-note-preview:free  # ordered list, first-pass chunk review
# VOD_MODEL_DEEP=anthropic/claude-sonnet-5.5       # closer looks + period/game reports
# VOD_MODEL_FALLBACK=google/gemini-3.8-flash       # after every basic model fails (default: deep model)
# VOD_MODEL_COOLDOWN_SECONDS=600                   # skip a rate-limited basic model for this long

# ---- Accuracy v2 (all OFF by default; see docs/worker-accuracy-v2-PLAN.md)
# VOD_HUD_READER=1                 # local FFmpeg+Tesseract score-bug timeline (no AI)
# VOD_HUD_STEP_SECONDS=2
# VOD_HUD_TEAM_ABBRS=CGY,LET       # fuzzy-match OCR'd team rows
# VOD_HUD_PROMPT=1                 # give the screener the HUD facts per chunk
# VOD_HUD_VALIDATION=flag          # off | flag | enforce
# VOD_HUD_PERIODS=propose          # off | propose | apply (still confirmed by management)
# VOD_ROSTER_SHEET=null            # off | null | flag
# VOD_ESCALATION=1                 # verify goals/penalties/low-confidence moments
# VOD_PREMIUM_MODEL=               # default = VOD_MODEL_DEEP (Gemini 4 Argon)
# VOD_CROSSCHECK_MODEL=deepseek/deepseek-v4.1-flash
# VOD_SPOTCHECK_MODEL=openai/gpt-6-astra   # frames-only, goals/penalties, Hitmen games only
# VOD_SPOTCHECK_TEAMS=CGY,Hitmen,Calgary
# VOD_SPOTCHECK_MAX_CALLS_PER_GAME=4
# VOD_SPOTCHECK_MAX_USD_PER_GAME=0.50
# VOD_MAX_USD_PER_GAME=0           # 0 = no dollar cap (request caps still apply)
# VOD_COST_LOG=1
# VOD_CORRECTIONS_FEWSHOT=0        # N recent corrections in prompts
# VOD_CORRECTIONS_FILE=/data/corrections.jsonl
